# ===== DADOS SENSÍVEIS (CRÍTICO) =====
.env
.env.*
!.env.example
vts_token*.txt
*.key
*.pem
*.crt
*.pfx

# ===== Modelos & Binários Pesados =====
# ATENÇÃO: /models/ (com /) só ignora o diretório na RAIZ do projeto (binários ML).
# NÃO usar "models/" sem a barra inicial — isso bloqueia src/akane_den/core/models/ também!
/models/
*.tar.bz2
*.tar.gz
*.zip
*.onnx
*.bin
*.pt
*.pth
*.gguf
*.safetensors
sensevoice_int8.tar.bz2

# ===== Bancos de Dados / Memória =====
local_chroma_db/
chroma.sqlite3
*.db
*.sqlite3

# ===== Chat History (Dados Pessoais) =====
chat_history/

# ===== Ambientes Virtuais =====
venv/
env/
.venv/
.env/

# ===== Logs e Saídas de Teste =====
logs/
*.log
test_output*.txt
install_log*.txt
push_log.txt
vision_test_out.txt
git_out.txt

